# ── Stripe (payments) ───────────────────────────────────────────────
# Dashboard → Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe,
# subscribed to `checkout.session.completed`. Paste its signing secret.
STRIPE_WEBHOOK_SECRET=

# Public origin used in Stripe redirect URLs (falls back to request origin)
NEXT_PUBLIC_SITE_URL=https://www.isvena.com

# ── Shiprocket (shipping) ───────────────────────────────────────────
# Create an API user under Shiprocket → Settings → API → Configure
# (these are the API user's credentials, NOT your main panel login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in Shiprocket
SHIPROCKET_PICKUP_LOCATION=Primary

# Customers are charged in USD; Shiprocket declares value in INR. This rate is
# used for the declared value on the manifest/customs paperwork only — it never
# changes what the customer pays. Defaults to 88 if unset.
SHIPROCKET_INR_PER_USD=88
