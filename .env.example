# ── Stripe (payments) ───────────────────────────────────────────────
# Dashboard → Developers → API keys (use sk_test_… while testing).
# Until this is set, the Checkout button falls back to the contact flow.
STRIPE_SECRET_KEY=

# The origin that actually serves the site. Stripe sends customers back here
# after payment, so a wrong value strands them on a dead domain *after* they
# have paid. Falls back to the incoming request origin if unset.
NEXT_PUBLIC_SITE_URL=https://www.isvena.com

# ── Local-currency display ──────────────────────────────────────────
# Set to `on` to show approximate local prices (≈ £255, ≈ AED 1,150) based on
# the visitor's country. Stripe still charges via Adaptive Pricing, which owns
# the real conversion.
#
# Only turn this on AFTER enabling Adaptive Pricing in the Stripe Dashboard.
# With it off there, the site would quote £255 and Stripe would charge $320.
NEXT_PUBLIC_LOCAL_PRICING=
