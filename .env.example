# ⚠ THIS FILE IS A TEMPLATE — IT CONFIGURES NOTHING.
#
# It is committed to git, so anything written here is public. Never put a real
# key in it. Next.js does not even read this file: it loads .env.local, .env,
# and the platform environment, and ignores .env.example entirely.
#
# Real values go in .env.local in the project root — gitignored, never committed.
# On the server that is /docker/isvena/.env.local (chmod 600). See SETUP.md.
#
# NEXT_PUBLIC_* values are compiled in at BUILD time: change one and you must
# re-run `npm run build`, not just restart. Other values are read at runtime.
#
# ── Cashfree (payments) ─────────────────────────────────────────────
# Dashboard → Developers → API Keys. Sandbox and production are two
# completely separate credential pairs — a TEST App ID never works against
# CASHFREE_ENV=production and vice versa. Until both are set, the order API
# returns 503 and checkout falls back to the contact flow.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# sandbox while testing, production when live. Must match which pair of keys
# is set above — mixing a sandbox App ID with CASHFREE_ENV=production (or the
# reverse) is rejected by Cashfree, not by this app.
CASHFREE_ENV=sandbox

# What the customer is actually charged in. Indian Cashfree accounts settle
# in INR unless International Payments has been activated on the account;
# with it on, set this to USD to bill the catalogue price directly.
CASHFREE_CURRENCY=INR

# Rupees per US dollar. The catalogue is priced in USD; this is the rate the
# house sells at, used BOTH to bill (what Cashfree actually charges) AND to
# display (the price shown sitewide — see below) — the same value, read from
# the same variable, so the two can never quietly drift apart. Review it
# when the rupee moves. Ignored for billing when CASHFREE_CURRENCY=USD, but
# still drives the display rate either way.
#
# NEXT_PUBLIC_* because prices render client-side as well as server-side,
# and a non-public env var is invisible in browser-executed code — not a
# choice, a Next.js constraint. The rate isn't a secret, so this costs
# nothing. Needs a rebuild to take effect, not just a restart — see
# SETUP.md section 3's Docker notes, since this also needs to be a build arg
# in docker-compose.yml and an ARG in the Dockerfile, same as
# NEXT_PUBLIC_SITE_URL below.
NEXT_PUBLIC_INR_PER_USD=88

# The origin that actually serves the site. Used for canonical URLs and the
# return path after payment. Falls back to the incoming request origin.
#
# Cashfree's webhook (order confirmation that doesn't depend on the
# customer's browser coming back) is only registered when this is an https://
# origin — see SETUP.md section 7.
NEXT_PUBLIC_SITE_URL=https://www.isvena.com

# ── Local-currency display (dormant) ────────────────────────────────
# INR is shown sitewide by default, at the exact rate Cashfree actually
# charges — not an estimate, because that's genuinely what a visitor pays
# right now regardless of where they are. Leave this unset. It exists for
# once International Payments is approved and multi-currency billing is
# real rather than cosmetic: set to `on` to show approximate local prices
# (≈ £255, ≈ AED 1,150) based on the visitor's country, with a USD / local
# switch in the header. See SETUP.md section 6 before touching this.
NEXT_PUBLIC_LOCAL_PRICING=

# ── Order notification email ────────────────────────────────────────
# Where every paid order is sent. Without a database and without an admin
# screen, this email is how the workshop learns an order exists — it carries
# the order number, pieces, engraving, and the full delivery address.
#
# Plain SMTP against the existing info@isvena.com mailbox (Titan Mail).
# Titan's dashboard must have "third-party app access" (or equivalent)
# enabled, or authentication fails without a clear reason — see SETUP.md
# section 8 for how to test this independent of a real order.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@isvena.com
SMTP_PASS=

# Port 465 is implicit TLS; 587 upgrades via STARTTLS. Leave unset to derive
# it from the port above.
SMTP_SECURE=

# Defaults to info@isvena.com. The recipient — where every order lands.
ORDER_EMAIL_TO=info@isvena.com

# Defaults to SMTP_USER. No separate mailbox needed — sending and receiving
# from the same info@isvena.com address is the simplest setup.
ORDER_EMAIL_FROM=
