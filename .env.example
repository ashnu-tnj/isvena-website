# ⚠ THIS FILE IS A TEMPLATE — IT CONFIGURES NOTHING.
#
# It is committed to git, so anything written here is public. Never put a real
# key in it. Next.js does not even read this file: it loads .env.local, .env,
# and the platform environment, and ignores .env.example entirely.
#
# Real values go in .env.local in the project root — gitignored, never committed.
# On the server that is /docker/isvena/.env.local (chmod 600). See SETUP.md.
#
# NEXT_PUBLIC_* values are compiled in at BUILD time: change one and you must
# re-run `npm run build`, not just restart. Other values are read at runtime.
#
# ── Cashfree (payments) ─────────────────────────────────────────────
# Dashboard → Developers → API Keys. Sandbox and production are two
# completely separate credential pairs — a TEST App ID never works against
# CASHFREE_ENV=production and vice versa. Until both are set, the order API
# returns 503 and checkout falls back to the contact flow.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# sandbox while testing, production when live. Must match which pair of keys
# is set above — mixing a sandbox App ID with CASHFREE_ENV=production (or the
# reverse) is rejected by Cashfree, not by this app.
CASHFREE_ENV=sandbox

# What the customer is actually charged in. Indian Cashfree accounts settle
# in INR unless International Payments has been activated on the account;
# with it on, set this to USD to bill the catalogue price directly.
CASHFREE_CURRENCY=INR

# Rupees per US dollar used to BILL, not to display. The catalogue is priced
# in USD, Cashfree charges in INR, and this is the rate between them — the
# rate the house is willing to sell at. Review it when the rupee moves.
# Ignored entirely when CASHFREE_CURRENCY=USD.
CASHFREE_INR_PER_USD=88

# The origin that actually serves the site. Used for canonical URLs and the
# return path after payment. Falls back to the incoming request origin.
#
# Cashfree's webhook (order confirmation that doesn't depend on the
# customer's browser coming back) is only registered when this is an https://
# origin — see SETUP.md section 6.
NEXT_PUBLIC_SITE_URL=https://www.isvena.com

# ── Local-currency display ──────────────────────────────────────────
# Set to `on` to show approximate local prices (≈ £255, ≈ AED 1,150) based on
# the visitor's country, and add a USD / local switch to the header. These
# are a guide only: Cashfree bills one currency (see CASHFREE_CURRENCY) and
# the customer's own bank sets the final conversion, so every figure is
# marked "≈" and the real amount appears on Cashfree's payment window.
# Country comes from an X-Geo-Country header if nginx supplies one, otherwise
# from the browser locale — so this works without GeoIP. See SETUP.md.
NEXT_PUBLIC_LOCAL_PRICING=

# ── Order notification email ────────────────────────────────────────
# Where every paid order is sent. Without a database and without an admin
# screen, this email is how the workshop learns an order exists — it carries
# the order number, pieces, engraving, and the full delivery address.
#
# Sent via Resend's API (resend.com — free tier is far more than this needs).
# Dashboard → API Keys.
RESEND_API_KEY=

# Defaults to info@isvena.com. The recipient — where every order lands.
ORDER_EMAIL_TO=info@isvena.com

# Defaults to Resend's shared sandbox sender, which only reaches the address
# that owns the API key and is marked as a test send either way — fine for
# confirming the wiring works, not for real orders. Real delivery needs
# isvena.com verified in the Resend dashboard (a couple of DNS records,
# verified in minutes) — not a separate mailbox, just the domain — after
# which this can be "Isvena <info@isvena.com>", same address as
# ORDER_EMAIL_TO. See SETUP.md section 8.
ORDER_EMAIL_FROM=
