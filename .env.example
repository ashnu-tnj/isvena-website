# ── Stripe (payments) ───────────────────────────────────────────────
# Dashboard → Developers → API keys (use sk_test_… while testing).
# Until this is set, the Checkout button falls back to the contact flow.
STRIPE_SECRET_KEY=

# The origin that actually serves the site. Stripe sends customers back here
# after payment, so a wrong value strands them on a dead domain *after* they
# have paid. Falls back to the incoming request origin if unset.
NEXT_PUBLIC_SITE_URL=https://www.isvena.com
