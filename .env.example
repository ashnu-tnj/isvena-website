# ⚠ THIS FILE IS A TEMPLATE — IT CONFIGURES NOTHING.
#
# It is committed to git, so anything written here is public. Never put a real
# key in it. Next.js does not even read this file: it loads .env.local, .env,
# and the platform environment, and ignores .env.example entirely.
#
# Real values go in .env.local in the project root — gitignored, never committed.
# On the server that is /var/docker/isvena/.env.local (chmod 600). See SETUP.md.
#
# NEXT_PUBLIC_* values are compiled in at BUILD time: change one and you must
# re-run `npm run build`, not just restart. Other values are read at runtime.
#
# ── Razorpay (payments) ─────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (use rzp_test_… while testing).
# Until both are set, the order API returns 503 and checkout falls back to
# the contact flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The key id again, for the browser: Razorpay's payment window needs it
# client-side, and it is publishable by design. Must match RAZORPAY_KEY_ID.
# NEVER give the SECRET a NEXT_PUBLIC_ prefix — that compiles it into every
# page of the site.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# What the customer is actually charged in. Indian Razorpay accounts settle
# in INR unless International Payments has been activated on the account;
# with it on, set this to USD to bill the catalogue price directly.
RAZORPAY_CURRENCY=INR

# Rupees per US dollar used to BILL, not to display. The catalogue is priced
# in USD, Razorpay charges in INR, and this is the rate between them — the
# rate the house is willing to sell at. Review it when the rupee moves.
# Ignored entirely when RAZORPAY_CURRENCY=USD.
RAZORPAY_INR_PER_USD=88

# The origin that actually serves the site. Used for canonical URLs and the
# return path after payment. Falls back to the incoming request origin.
NEXT_PUBLIC_SITE_URL=https://www.isvena.com

# ── Local-currency display ──────────────────────────────────────────
# Set to `on` to show approximate local prices (≈ £255, ≈ AED 1,150) based on
# the visitor's country, and add a USD / local switch to the header. These
# are a guide only: Razorpay bills one currency (see RAZORPAY_CURRENCY) and
# the customer's own bank sets the final conversion, so every figure is
# marked "≈" and the real amount appears on Razorpay's payment window.
# Country comes from an X-Geo-Country header if nginx supplies one, otherwise
# from the browser locale — so this works without GeoIP. See SETUP.md.
NEXT_PUBLIC_LOCAL_PRICING=
